// ======================================================
// PROJECT: TEMPERATURE CONVERSION SYSTEM
// LANGUAGE: C++
// DESCRIPTION: Converts temperatures between Celsius,
// Fahrenheit, and Kelvin.
// ======================================================

#include <iostream>
#include <iomanip>
#include <limits>
using namespace std;

// Function to convert Celsius to Fahrenheit
double celsiusToFahrenheit(double celsius)
{
    return (celsius * 9.0 / 5.0) + 32.0;
}

// Function to convert Fahrenheit to Celsius
double fahrenheitToCelsius(double fahrenheit)
{
    return (fahrenheit - 32.0) * 5.0 / 9.0;
}

// Function to convert Celsius to Kelvin
double celsiusToKelvin(double celsius)
{
    return celsius + 273.15;
}

// Function to convert Kelvin to Celsius
double kelvinToCelsius(double kelvin)
{
    return kelvin - 273.15;
}

// Function to convert Fahrenheit to Kelvin
double fahrenheitToKelvin(double fahrenheit)
{
    return (fahrenheit - 32.0) * 5.0 / 9.0 + 273.15;
}

// Function to convert Kelvin to Fahrenheit
double kelvinToFahrenheit(double kelvin)
{
    return (kelvin - 273.15) * 9.0 / 5.0 + 32.0;
}

// Main function
int main()
{
    int choice;
    double temperature, result;
    char again;

    cout << fixed << setprecision(2);

    cout << "========================================\n";
    cout << "     TEMPERATURE CONVERSION SYSTEM\n";
    cout << "========================================\n";

    do
    {
        cout << "\nSelect a conversion:\n";
        cout << "1. Celsius to Fahrenheit\n";
        cout << "2. Fahrenheit to Celsius\n";
        cout << "3. Celsius to Kelvin\n";
        cout << "4. Kelvin to Celsius\n";
        cout << "5. Fahrenheit to Kelvin\n";
        cout << "6. Kelvin to Fahrenheit\n";
        cout << "7. Exit\n";

        cout << "\nEnter your choice: ";

        if (!(cin >> choice))
        {
            cout << "Error: Please enter a valid number.\n";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            continue;
        }

        if (choice == 7)
        {
            cout << "\nThank you for using the Temperature "
                 << "Conversion System!\n";
            break;
        }

        if (choice < 1 || choice > 6)
        {
            cout << "Invalid choice! Please select from 1 to 7.\n";
            continue;
        }

        cout << "Enter the temperature: ";

        if (!(cin >> temperature))
        {
            cout << "Error: Please enter a valid temperature.\n";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            continue;
        }

        // Reject temperatures below absolute zero.
        // Kelvin cannot be negative.
        if ((choice == 1 || choice == 3) && temperature < -273.15)
        {
            cout << "Error: Temperature cannot be below "
                 << "absolute zero (-273.15 C).\n";
            continue;
        }

        if ((choice == 2 || choice == 5) && temperature < -459.67)
        {
            cout << "Error: Temperature cannot be below "
                 << "absolute zero (-459.67 F).\n";
            continue;
        }

        if ((choice == 4 || choice == 6) && temperature < 0)
        {
            cout << "Error: Kelvin temperature cannot be negative.\n";
            continue;
        }

        // Perform the selected conversion.
        switch (choice)
        {
            case 1:
                result = celsiusToFahrenheit(temperature);
                cout << "\nResult: " << temperature
                     << " C = " << result << " F\n";
                break;

            case 2:
                result = fahrenheitToCelsius(temperature);
                cout << "\nResult: " << temperature
                     << " F = " << result << " C\n";
                break;

            case 3:
                result = celsiusToKelvin(temperature);
                cout << "\nResult: " << temperature
                     << " C = " << result << " K\n";
                break;

            case 4:
                result = kelvinToCelsius(temperature);
                cout << "\nResult: " << temperature
                     << " K = " << result << " C\n";
                break;

            case 5:
                result = fahrenheitToKelvin(temperature);
                cout << "\nResult: " << temperature
                     << " F = " << result << " K\n";
                break;

            case 6:
                result = kelvinToFahrenheit(temperature);
                cout << "\nResult: " << temperature
                     << " K = " << result << " F\n";
                break;
        }

        cout << "\nDo you want to convert another temperature? (y/n): ";
        cin >> again;

        // Handle unexpected characters in the repeat prompt.
        if (again != 'y' && again != 'Y' &&
            again != 'n' && again != 'N')
        {
            cout << "Invalid response. Returning to the menu.\n";
            again = 'y';
        }

    } while (again == 'y' || again == 'Y');

    cout << "\nProgram closed successfully.\n";

    return 0;
}
